# ======================
# LexAI Environment Variables
# ======================

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxx

# HuggingFace Inference API
HUGGINGFACE_API_KEY=hf_xxxxx

# Vercel Postgres (auto-provisioned via Vercel Dashboard)
POSTGRES_URL=postgres://user:pass@host:5432/dbname
POSTGRES_PRISMA_URL=postgres://user:pass@host:5432/dbname?pgbouncer=true
POSTGRES_URL_NON_POOLING=postgres://user:pass@host:5432/dbname

# Upstash Redis (auto-provisioned via Vercel Marketplace)
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxx

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=vercel_blob_xxxxx

# LibreTranslate (Public API)
LIBRETRANSLATE_URL=https://libretranslate.com

# App URL (for share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
